(async function () {
    console.log("🔍 Google Maps Tracker Active...");

    try {
        if ("caches" in window) {
            caches.keys().then(names => names.forEach(name => caches.delete(name)));
        }
        localStorage.clear();
        sessionStorage.clear();
        console.log("🗑️ Browser cache cleared.");
    } catch (e) {
        console.warn("Cache clear error:", e.message);
    }

    // Shared store: MAIN world posts RPC results here via custom event
    window.__ltRpc = {
        latitude: "Not found",
        longitude: "Not found",
        address: "Not found"
    };

    window.addEventListener("message", function (ev) {
        if (!ev.data || ev.data.source !== "LT_RPC_INTERCEPT") return;
        if (ev.data.latitude && ev.data.latitude !== "Not found") {
            window.__ltRpc = {
                latitude: ev.data.latitude,
                longitude: ev.data.longitude,
                address: ev.data.address || "Address not available"
            };
            console.log("✅ RPC from MAIN world:", window.__ltRpc.latitude, window.__ltRpc.longitude, window.__ltRpc.address);
        }
    });

    // Inject intercept into PAGE main world (Maps fetch lives there)
    const inject = document.createElement("script");
    inject.textContent = "(" + function () {
        function extract(data) {
            try {
                if (!data || !Array.isArray(data) || data.length < 1 || !Array.isArray(data[0])) return null;
                for (var i = 0; i < data[0].length; i++) {
                    var entry = data[0][i];
                    if (Array.isArray(entry) && entry[1] && Array.isArray(entry[1][1])) {
                        return {
                            latitude: entry[1][1][2],
                            longitude: entry[1][1][1],
                            address: entry[1][4] || "Address not available"
                        };
                    }
                }
            } catch (e) {}
            return null;
        }
        function parseBody(text) {
            try {
                var raw = text;
                if (raw.indexOf(")]}'") === 0) {
                    var nl = raw.indexOf("\\n");
                    raw = nl >= 0 ? raw.substring(nl + 1) : raw.substring(4);
                } else if (raw.length > 5 && raw.charAt(0) === ")") {
                    raw = raw.substring(5);
                }
                return extract(JSON.parse(raw));
            } catch (e) {
                return null;
            }
        }
        function publish(loc) {
            if (!loc || loc.latitude == null) return;
            window.postMessage({
                source: "LT_RPC_INTERCEPT",
                latitude: loc.latitude,
                longitude: loc.longitude,
                address: loc.address
            }, "*");
        }
        var ofetch = window.fetch;
        window.fetch = function () {
            var args = arguments;
            return ofetch.apply(this, args).then(function (response) {
                try {
                    var u = "";
                    if (typeof args[0] === "string") u = args[0];
                    else if (args[0] && args[0].url) u = args[0].url;
                    if (u && u.indexOf("locationsharing/read") !== -1) {
                        response.clone().text().then(function (t) {
                            var loc = parseBody(t);
                            if (loc) publish(loc);
                        }).catch(function () {});
                    }
                } catch (e) {}
                return response;
            });
        };
        var oOpen = XMLHttpRequest.prototype.open;
        var oSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function (m, url) {
            this.__ltUrl = url;
            return oOpen.apply(this, arguments);
        };
        XMLHttpRequest.prototype.send = function () {
            var xhr = this;
            this.addEventListener("load", function () {
                try {
                    if (xhr.__ltUrl && String(xhr.__ltUrl).indexOf("locationsharing/read") !== -1) {
                        var loc = parseBody(xhr.responseText || "");
                        if (loc) publish(loc);
                    }
                } catch (e) {}
            });
            return oSend.apply(this, arguments);
        };
        console.log("[LT] MAIN world RPC intercept installed");
    } + ")();";
    (document.documentElement || document.head).appendChild(inject);
    inject.remove();

    async function waitForElement(selector, timeout) {
        timeout = timeout || 10000;
        return new Promise(function (resolve, reject) {
            var start = Date.now();
            function check() {
                var el = document.querySelector(selector);
                if (el) {
                    console.log("✅ Found:", selector);
                    resolve(el);
                } else if (Date.now() - start > timeout) {
                    reject(new Error("Timeout: " + selector));
                } else {
                    setTimeout(check, 500);
                }
            }
            check();
        });
    }

    async function getBatteryLevel() {
        try {
            var el = await waitForElement(
                'div.LCF4w span[aria-label="Battery level"] + span.JpCtJf span span[jslog*="mutable:true"]',
                10000
            );
            var m = (el.innerText || "").match(/\\d+%/);
            if (m) {
                console.log("✅ Battery:", m[0]);
                return m[0];
            }
            return "Battery info not available";
        } catch (e) {
            return "Battery info not available";
        }
    }

    async function scrapeLocalTime() {
        try {
            var el = await waitForElement(
                'div.LCF4w span.JpCtJf span[jslog*="mutable:true"]:not([aria-label])',
                10000
            );
            var t = (el.innerText || "").replace("Local time · ", "").replace("Hours, ", "").trim();
            console.log("✅ Local time:", t);
            return t || "N/A";
        } catch (e) {
            return "N/A";
        }
    }

    async function getGoogleAccount() {
        try {
            var el = await waitForElement(".DUwDvf.lfPIob", 10000);
            return el ? el.innerText.trim() : "Google Account not found";
        } catch (e) {
            return "Google Account not found";
        }
    }

    async function getLastUpdateFromPage() {
        try {
            var el = await waitForElement("h2.bwoZTb.fontBodyMedium span", 10000);
            return el ? el.innerText.trim() : "Last update not found";
        } catch (e) {
            return "Last update not found";
        }
    }

    function getOldLocationData() {
        var m = window.location.href.match(/@(-?\\d+\\.\\d+),(-?\\d+\\.\\d+)/);
        if (m) return { old_latitude: m[1], old_longitude: m[2] };
        return { old_latitude: "Not found", old_longitude: "Not found" };
    }

    async function fetchLocationData() {
        if (window.__ltRpc && window.__ltRpc.latitude !== "Not found") {
            return {
                latitude: window.__ltRpc.latitude,
                longitude: window.__ltRpc.longitude,
                address: window.__ltRpc.address
            };
        }
        console.warn("No intercepted RPC yet — refresh Maps with shared panel open");
        return { latitude: "Not found", longitude: "Not found", address: "Not found" };
    }

    async function fetchData() {
        await new Promise(function (r) { setTimeout(r, 8000); });

        var oldLocationData = getOldLocationData();
        var locationData = await fetchLocationData();

        locationData.old_latitude = oldLocationData.old_latitude;
        locationData.old_longitude = oldLocationData.old_longitude;

        if (locationData.latitude === "Not found" && oldLocationData.old_latitude !== "Not found") {
            locationData.latitude = oldLocationData.old_latitude;
            locationData.longitude = oldLocationData.old_longitude;
        }

        locationData["lat,long"] = locationData.latitude + ", " + locationData.longitude;
        locationData.localTime = await scrapeLocalTime();
        locationData.batteryLevel = await getBatteryLevel();
        locationData.googleAccount = await getGoogleAccount();
        locationData.lastUpdate = await getLastUpdateFromPage();
        locationData.serverTime = new Date().toLocaleString(undefined, { hour12: false });

        console.log("📌 Captured Location Data:", locationData);
        saveLocationData(locationData);
    }

    function saveLocationData(data) {
        var stored = JSON.parse(localStorage.getItem("sharedLocationData") || "[]");
        stored.unshift(data);
        stored = stored.slice(0, 100);
        localStorage.setItem("sharedLocationData", JSON.stringify(stored));
        saveToJson(stored);
    }

    function saveToJson(data) {
        var ts = new Date().toISOString().replace(/[:.-]/g, "_");
        var blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url;
        a.download = "LatLong_" + ts + ".json";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    setTimeout(function () {
        fetchData();
        setInterval(fetchData, 120000);
    }, 3000);
})();
